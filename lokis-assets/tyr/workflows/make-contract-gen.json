{
  "meta": {
    "product": "Týr's Code",
    "price": "$59",
    "platform": ["make.com", "n8n"],
    "version": "1.0.0",
    "author": "Loki's Mischief",
    "description": "Contract generation, compliance monitoring, and ethical guardrails for agencies.",
    "usage": "Import JSON, connect document and compliance data sources."
  },
  "scenario": {
    "name": "Compliance Router",
    "flow": [
      { "id": "1", "module": "HTTP", "action": "Make a request", "fields": { "endpoint": "YOUR_INTAKE_WEBHOOK", "method": "POST", "headers": { "Content-Type": "application/json" } } },
      { "id": "2", "module": "Tools", "action": "Text Parser", "fields": { "mode": "regex", "pattern": "(contract|nda|sla|gdpr|hipaa|audit)" } },
      { "id": "3", "module": "Flow Control", "action": "Router", "routing": [ { "name": "Contract", "patterns": ["contract","nda","sla"] }, { "name": "Compliance", "patterns": ["gdpr","hipaa","audit"] }, { "name": "Policy", "patterns": ["policy","ethics"] } ] },
      { "id": "4", "module": "Google Docs", "action": "Create document", "fields": { "title": "Týr Draft: {{3.name}}" } },
      { "id": "5", "module": "Email", "action": "Send email", "fields": { "to": "legal@company.com", "subject": "Týr review: {{3.name}}" } }
    ]
  }
}
