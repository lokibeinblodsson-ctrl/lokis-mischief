{
  "meta": {
    "product": "Mjölnir Infrastructure",
    "price": "$69",
    "platform": ["make.com", "n8n"],
    "version": "1.0.0",
    "author": "Loki's Mischief",
    "description": "Security hardening checklist, threat scanner, and scale readiness suite.",
    "usage": "Import in Make or n8n, connect infra tools."
  },
  "scenario": {
    "name": "Security Scan & Hardening",
    "flow": [
      {
        "id": "1",
        "module": "HTTP",
        "action": "Make a request",
        "fields": { "endpoint": "YOUR_SECURITY_SCANNER_API", "method": "POST", "headers": { "Authorization": "Bearer YOUR_TOKEN" } }
      },
      {
        "id": "2",
        "module": "Tools",
        "action": "Text Parser",
        "fields": { "mode": "regex", "pattern": "(critical|high|medium|low)" }
      },
      {
        "id": "3",
        "module": "Flow Control",
        "action": "Router",
        "routing": [
          { "name": "Critical", "patterns": ["critical"] },
          { "name": "Warning", "patterns": ["high","medium"] },
          { "name": "Healthy", "patterns": ["low"] }
        ]
      },
      {
        "id": "4",
        "module": "Email",
        "action": "Send email",
        "fields": { "to": "ops@company.com", "subject": "Security alert: {{3.name}}" }
      },
      {
        "id": "5",
        "module": "Slack",
        "action": "Send message",
        "fields": { "channel": "#security", "text": "Found status {{3.name}} from last scan." }
      }
    ]
  }
}
