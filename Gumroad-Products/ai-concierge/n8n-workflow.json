        "operation": "send",
        "to": "={{ $node['Webhook'].json.body.email }}",
        "subject": "Your Discovery Call is Confirmed – {{ $node['Webhook'].json.body.company }}",
        "htmlBody": "<html><body style='font-family: Arial, Helvetica, sans-serif; max-width: 600px; margin: 0 auto;'><h2 style='color: #2563eb;'>Hi {{ $node['Webhook'].json.body.name }},</h2><p>Thank you for reaching out! We're excited to learn more about your project at <strong>{{ $node['Webhook'].json.body.company }}</strong>.</p><div style='background: #f0f9ff; border-left: 4px solid #2563eb; padding: 16px; margin: 16px 0;'><h3 style='margin-top: 0;'>Your Discovery Call</h3><p><strong>Date:</strong> {{ new Date($node['Create Calendar Event'].json.start.dateTime || $now.plus({days: 2})).toLocaleDateString('en-US', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }) }}<br><strong>Time:</strong> 10:00 AM – 10:30 AM (Eastern)<br><strong>Duration:</strong> 30 minutes<br><strong>Format:</strong> Google Meet video call</p><p><a href='{{ $node['Create Calendar Event'].json.hangoutLink || '#' }}' style='display: inline-block; background: #2563eb; color: white; padding: 12px 24px; text-decoration: none; border-radius: 6px; font-weight: bold;'>Join Google Meet</a></p><p><a href='{{ $node['Create Calendar Event'].json.htmlLink || '#' }}' style='color: #2563eb;'>Add to Google Calendar</a></p></div><h3>What We'll Cover</h3><ul><li>Understanding your project goals and requirements</li><li>Discussing timeline and budget expectations</li><li>Outlining how we can deliver value for {{ $node['Webhook'].json.body.service_interest }}</li></ul><p>Best regards,<br><strong>The Concierge Team</strong></p></body></html>",
        "sendAs": "me"
      },
      "credentials": {
        "gmailOAuth2": {
          "id": null,
          "name": "Gmail Account"
        }
      }
    },
