          "createRequest": {
            "requestId": "={{ Date.now().toString() }}",
            "conferenceSolutionKey": {
              "type": "hangoutsMeet"
            }
          }
        }
      },
      "credentials": {
        "googleCalendarApi": {
          "id": null,
          "name": "Google Calendar Account"
        }
      }
