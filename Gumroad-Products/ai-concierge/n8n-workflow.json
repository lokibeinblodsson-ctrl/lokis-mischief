      "typeVersion": 2,
      "position": [940, 150],
      "parameters": {
        "operation": "create",
        "calendar": {
          "__rl": true,
          "value": "primary",
          "mode": "id"
        },
        "title": "Discovery Call: {{ $node['Webhook'].json.body.company }}",
        "startTime": "={{ $now.plus({days: 2}).toISO().substring(0, 10) + 'T10:00:00.000Z' }}",
        "endTime": "={{ $now.plus({days: 2}).toISO().substring(0, 10) + 'T10:30:00.000Z' }}",
        "timeZone": "America/New_York",
        "description": "Discovery Call with {{ $node['Webhook'].json.body.name }} from {{ $node['Webhook'].json.body.company }}\n\nService Interest: {{ $node['Webhook'].json.body.service_interest }}\nBudget: {{ $node['Webhook'].json.body.budget }}\nOriginal Message: {{ $node['Webhook'].json.body.message }}",
        "location": "Google Meet Video Call",
        "attendees": [
          {
            "email": "={{ $node['Webhook'].json.body.email }}",
            "displayName": "={{ $node['Webhook'].json.body.name }}"
          }
        ],
