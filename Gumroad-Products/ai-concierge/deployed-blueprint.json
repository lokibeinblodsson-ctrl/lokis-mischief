                "url": "https://agency.com/internal/decline-lead?lead={{1.email}}"
              }
            ]
          },
          {
            "type": "context",
            "elements": [
              {
                "type": "mrkdwn",
                "text": "🤖 *AI Client Concierge* · Automated lead qualification and scheduling · {{timestamp}}"
              }
            ]
          }
        ],
        "attachments": []
      },
      "moduleModel": {
        "type": "slack",
        "nativeType": "slack",
        "label": "Notify Team via Slack",
        "notes": "Sends a rich Slack message to #lead-alerts with lead summary, AI analysis, action buttons, and calendar link."
      }
    },
    {
      "id": 8,
      "module": "gmail:sendEmail",
      "version": 2,
      "metadata": {
        "designer": {
          "x": 640,
          "y": 380
        },
        "parameters": {
          "connection": "{{8.connection}}"
        }
      },
      "parameters": {
        "connection": "{{8.connection}}"
      },
      "mapper": {
        "to": "{{1.email}}",
        "cc": "",
        "bcc": "team@agency.com",
        "subject": "Thank You for Your Inquiry — {{1.name}}",
        "bodyType": "html",
        "body": "<!DOCTYPE html>\n<html>\n<head>\n  <meta charset=\"UTF-8\">\n  <style>\n    body { font-family: 'Segoe UI', Helvetica, Arial, sans-serif; margin: 0; padding: 0; background-color: #f4f6f8; }\n    .container { max-width: 600px; margin: 0 auto; background: #ffffff; border-radius: 12px; overflow: hidden; box-shadow: 0 2px 12px rgba(0,0,0,0.08); }\n    .header { background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%); padding: 40px 30px; text-align: center; }\n    .header h1 { color: #ffffff; margin: 0; font-size: 28px; font-weight: 700; }\n    .header p { color: rgba(255,255,255,0.9); margin: 8px 0 0 0; font-size: 16px; }\n    .content { padding: 30px; }\n    .greeting { font-size: 18px; color: #2d3748; margin-bottom: 20px; }\n    .greeting strong { color: #667eea; }\n    .recommendation-box { background: #fff5f5; border-left: 4px solid #f5576c; padding: 20px; margin: 20px 0; border-radius: 0 8px 8px 0; }\n    .recommendation-box h3 { margin: 0 0 12px 0; color: #2d3748; font-size: 16px; }\n    .recommendation-box p, .recommendation-box li { color: #4a5568; font-size: 14px; line-height: 1.7; }\n    .resource-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin: 20px 0; }\n    .resource-item { background: #f7fafc; padding: 20px; border-radius: 8px; text-align: center; }\n    .resource-item h4 { margin: 0 0 8px 0; color: #2d3748; font-size: 15px; }\n    .resource-item p { margin: 0; color: #718096; font-size: 13px; }\n    .resource-item a { color: #667eea; text-decoration: none; font-weight: 600; }\n    .message-box { background: #ebf4ff; padding: 20px; border-radius: 8px; margin: 20px 0; }\n    .message-box p { margin: 0; color: #2b6cb0; font-style: italic; font-size: 14px; }\n    .footer { padding: 20px 30px; background: #f7fafc; text-align: center; border-top: 1px solid #e2e8f0; }\n    .footer p { margin: 4px 0; color: #a0aec0; font-size: 12px; }\n    .footer a { color: #667eea; text-decoration: none; }\n    hr { border: none; border-top: 1px solid #e2e8f0; margin: 24px 0; }\n  </style>\n</head>\n<body>\n  <div class=\"container\">\n    <div class=\"header\">\n      <h1>Thank You for Reaching Out 🙏</h1>\n      <p>We appreciate your interest in Agency</p>\n    </div>\n    <div class=\"content\">\n      <p class=\"greeting\">Hi <strong>{{1.name}}</strong>,</p>\n      <p style=\"color: #4a5568; font-size: 15px; line-height: 1.7;\">\n        Thank you so much for taking the time to reach out to us! We truly appreciate \n        your interest in <strong>{{1.service_interest}}</strong> for {{1.company}}.\n      </p>\n\n      <p style=\"color: #4a5568; font-size: 15px; line-height: 1.7;\">\n        After carefully reviewing your inquiry, we've determined that our current services \n        and engagement model may not be the best fit for your needs at this time. We want \n        to be transparent about this upfront so we don't waste your valuable time.\n      </p>\n\n      <div class=\"recommendation-box\">\n        <h3>💡 Recommendations & Resources</h3>\n        <p>While we can't take on this project right now, here are some resources that may help:</p>\n        <ul>\n          <li><strong>Service:</strong> Based on your interest in {{1.service_interest}}, we recommend exploring <a href=\"https://agency.com/alternatives\" style=\"color: #667eea;\">these alternative solutions</a> that might be a better fit.</li>\n          <li><strong>Budget:</strong> For projects in the {{1.budget}} range, consider starting with a smaller scoped engagement to validate your concept.</li>\n          <li><strong>DIY Resources:</strong> Check out our <a href=\"https://agency.com/blog\" style=\"color: #667eea;\">blog</a> and <a href=\"https://agency.com/resources\" style=\"color: #667eea;\">free resources</a> for guides and templates you can use on your own.</li>\n        </ul>\n      </div>\n\n      <div class=\"message-box\">\n        <p>\"{{2.data.personalized_response}}\"</p>\n      </div>\n\n      <hr>\n\n      <h3 style=\"color: #2d3748; font-size: 16px; margin-top: 24px;\">🔍 Other Ways We Can Help</h3>\n\n      <div class=\"resource-grid\">\n        <div class=\"resource-item\">\n          <h4>📚 Free Resources</h4>\n          <p>Guides, templates, and tools</p>\n          <a href=\"https://agency.com/resources\">Browse Resources →</a>\n        </div>\n        <div class=\"resource-item\">\n          <h4>📝 Blog</h4>\n          <p>Industry insights and tips</p>\n          <a href=\"https://agency.com/blog\">Read Blog →</a>\n        </div>\n        <div class=\"resource-item\">\n          <h4>💬 Community</h4>\n          <p>Join our free community</p>\n          <a href=\"https://agency.com/community\">Join Now →</a>\n        </div>\n        <div class=\"resource-item\">\n          <h4>📞 Future Projects</h4>\n          <p>We'd love to help in the future</p>\n          <a href=\"https://agency.com/contact\">Stay in Touch →</a>\n        </div>\n      </div>\n\n      <p style=\"color: #4a5568; font-size: 15px; line-height: 1.7; margin-top: 24px;\">\n        We'll keep your information on file for future opportunities. If your needs change \n        or you'd like to explore a different scope of work, please don't hesitate to reach out again.\n      </p>\n\n      <p style=\"color: #4a5568; font-size: 15px; line-height: 1.7;\">\n        We wish you the very best with {{1.company}}!\n      </p>\n      <p style=\"color: #2d3748; font-size: 15px; line-height: 1.7;\">\n        Warm regards,<br>\n        <strong>The Agency Team</strong><br>\n        <span style=\"color: #667eea; font-size: 13px;\">hello@agency.com | (555) 123-4567</span>\n      </p>\n    </div>\n    <div class=\"footer\">\n      <p>© {{formatDate(now, \"YYYY\")}} Agency. All rights reserved.</p>\n      <p>123 Business Ave, Suite 100, New York, NY 10001</p>\n      <p>\n        <a href=\"https://agency.com/privacy\">Privacy Policy</a> ·\n        <a href=\"https://agency.com/terms\">Terms of Service</a> ·\n        <a href=\"mailto:hello@agency.com\">Contact Us</a>\n      </p>\n    </div>\n  </div>\n</body>\n</html>",
        "fromName": "Agency Concierge Team",
