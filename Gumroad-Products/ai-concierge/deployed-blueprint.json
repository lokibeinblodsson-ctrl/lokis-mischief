            }
          },
          {
            "type": "section",
            "text": {
              "type": "mrkdwn",
              "text": "*AI Response:*\n> {{2.data.personalized_response}}"
            }
          },
          {
            "type": "section",
            "text": {
              "type": "mrkdwn",
              "text": "*Suggested Talking Points:*\n• {{2.data.suggested_meeting_topics[0]}}\n• {{2.data.suggested_meeting_topics[1]}}\n• {{2.data.suggested_meeting_topics[2]}}"
            }
          },
          {
            "type": "divider"
          },
          {
            "type": "section",
            "text": {
              "type": "mrkdwn",
              "text": "*📅 Discovery Call Scheduled:* {{formatDate(addDays(now, 2), \"YYYY-MM-DD\")}} at 10:00 AM ET\n*🔗 Google Meet:* {{4.conferenceData.entryPoints[0].uri}}\n*📊 Sheet:* View in <https://docs.google.com/spreadsheets/d/YOUR_SPREADSHEET_ID_HERE|Qualified Leads Tracker>"
            }
          },
          {
            "type": "actions",
            "elements": [
              {
                "type": "button",
                "text": {
                  "type": "plain_text",
                  "text": "✉️ Email Prospect",
                  "emoji": true
                },
                "url": "mailto:{{1.email}}?subject=Re: Your Discovery Call",
                "style": "primary"
              },
              {
                "type": "button",
                "text": {
                  "type": "plain_text",
                  "text": "📅 Open Calendar",
                  "emoji": true
                },
                "url": "{{4.htmlLink}}",
                "style": "primary"
              },
              {
                "type": "button",
                "text": {
                  "type": "plain_text",
                  "text": "❌ Not Interested",
                  "emoji": true
                },
